{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-mobile-agent:schema:qa-request:1",
  "title": "QA Request",
  "description": "Input handed to the mobile-qa skill for one validation cycle. The validator receives ONLY this file plus the build artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "platform", "target", "build_path", "cycle", "mode"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue": { "type": "string", "minLength": 1 },
    "figma_url": { "type": "string", "format": "uri" },
    "acceptance_criteria": {
      "type": "array",
      "description": "Optional pre-extracted criteria. If omitted, the skill reads them from the tracker.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "platform": { "enum": ["android", "ios"] },
    "target": { "enum": ["simulator", "emulator", "physical", "cloud"] },
    "device": { "type": "string" },
    "build_path": { "type": "string" },
    "cycle": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["validate", "validate_and_regress", "regress_only"] },
    "flows": { "type": "array", "items": { "type": "string" }, "description": "Subset of regression flows to run. Empty means all." },
    "previous_verdict_path": { "type": "string", "description": "Last approved verdict, used to flag regressions." },
    "output_dir": { "type": "string" },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_seconds": { "type": "integer", "minimum": 1 },
        "run_minutes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
